{
  "manifest_version": 3,
  "name": "Product Importer to Sheets",
  "version": "2.2.0",
  "description": "Production-ready product scraper for MercadoLibre, Amazon, eBay and 20+ e-commerce platforms",
  "permissions": [
    "activeTab",
    "scripting",
    "notifications",
    "storage",
    "contextMenus",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://script.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["scraper-engine.js", "table-extract.js", "content.js"],
      "css": ["table-extract.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["scraper-engine.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
